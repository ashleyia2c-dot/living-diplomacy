# Player2 is the default LLM and TTS service. Keep the app open while playing.
LLMDIP_PROVIDER=player2

# Empty = discover the port from %APPDATA%\game.player2.client\api.port.
LLMDIP_PLAYER2_URL=

# Empty = use Player2's Default profile and the model selected in its UI.
LLMDIP_PLAYER2_PROFILE=

# Optional game client id from Player2's developer dashboard. Local mod use can leave it empty.
LLMDIP_PLAYER2_GAME_KEY=

# Player2 plays each leader response through its selected speech model/output device.
LLMDIP_PLAYER2_TTS=1
# Empty lets Player2's "match voice language" setting decide.
LLMDIP_PLAYER2_TTS_LANGUAGE=
LLMDIP_PLAYER2_TTS_SPEED=1

# Optional OpenAI-compatible fallback instead of Player2:
# LLMDIP_PROVIDER=openai
# LLMDIP_BASE_URL=https://api.x.ai/v1
# LLMDIP_MODEL=grok-4-1-fast-reasoning
# LLMDIP_API_KEY=

WH3_ROOT=C:\Program Files (x86)\Steam\steamapps\common\Total War WARHAMMER III

# Safe mod-only bridge log. Empty/unset defaults to WH3_ROOT\lua_mod_log.txt.
# WH3_SCRIPT_LOG remains accepted only as a backwards-compatible override.
WH3_BRIDGE_LOG=
LLMDIP_POLL_MS=500
LLMDIP_PORT=43127

# Betrayals: allied or treaty-bound factions with a treacherous nature may betray you
# (declare war) in their letters when it pays. Set to 0 to disable them.
LLMDIP_BETRAYALS=1
